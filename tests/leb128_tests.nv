// leb128_tests.nv — the DWARF specification's own examples, the range
// ends, and the two ways a reader can be handed something malformed.
//
// Run from the package directory:
//   novo test tests/leb128_tests.nv
//
// The vectors in `test_dwarf_unsigned_examples` are DWARF 4 §7.6's
// table of unsigned LEB128 encodings, copied value for value.  They are
// the reason to trust this encoder against any other implementation of
// the format rather than against itself.

use std.bytes
use std.list
use std.test
use leb128

// The encoding of `value`, as lowercase hex — the shape a vector table
// is written in.
fn hex_of(value: Int) -> Str
    bytes.to_hex(leb128.encode(value))

// The value `hex` decodes to, or a label naming the failure, so a table
// row can assert both outcomes with one comparison.
fn decoded_text(hex: Str) -> Str
    match leb128.decode(bytes.from_hex(hex) ?? bytes.zeros(0))
        Ok(v)  => str.from_int(v)
        Err(e) => e.message()

@test
fn test_dwarf_unsigned_examples() [io]
    // DWARF 4 §7.6, "Examples of unsigned LEB128 encodings".
    test.assert_eq_str(hex_of(2), "02")
    test.assert_eq_str(hex_of(127), "7f")
    test.assert_eq_str(hex_of(128), "8001")
    test.assert_eq_str(hex_of(129), "8101")
    test.assert_eq_str(hex_of(130), "8201")
    test.assert_eq_str(hex_of(12857), "b964")

@test
fn test_the_worked_example_from_the_format_description() [io]
    // 624485 is the value every description of LEB128 walks through,
    // because it is the smallest one that needs three groups.
    test.assert_eq_str(hex_of(624485), "e58e26")
    test.assert_eq_str(decoded_text("e58e26"), "624485")

@test
fn test_zero_is_one_byte_and_round_trips() [io]
    test.assert_eq_str(hex_of(0), "00")
    test.assert_eq_str(decoded_text("00"), "0")
    test.assert_eq(leb128.encoded_len(0), 1)

@test
fn test_the_group_boundaries() [io]
    // One byte holds 7 bits, so the length steps at every 7th power of
    // two and nowhere else.
    test.assert_eq(leb128.encoded_len(127), 1)
    test.assert_eq(leb128.encoded_len(128), 2)
    test.assert_eq(leb128.encoded_len(16383), 2)
    test.assert_eq(leb128.encoded_len(16384), 3)

@test
fn test_the_whole_unsigned_range_round_trips() [io]
    // A negative `Int` is the bit pattern of a u64 at or above 2^63.
    // The top of the range is ten bytes, which is `max_len`.
    let all_ones = 0 - 1
    test.assert_eq(leb128.encoded_len(all_ones), leb128.max_len())
    test.assert_eq_str(hex_of(all_ones), "ffffffffffffffffff01")
    test.assert_eq_str(decoded_text("ffffffffffffffffff01"), str.from_int(all_ones))
    let two_to_the_63 = 1 << 63
    test.assert_eq_str(decoded_text(hex_of(two_to_the_63)), str.from_int(two_to_the_63))

@test
fn test_a_truncated_varint_is_a_value() [io]
    // Every byte says "more follows" and then the input stops.
    match leb128.decode(bytes.from_hex("8080") ?? bytes.zeros(0))
        Ok(v)  => test.fail("a truncated varint decoded to ${v}")
        Err(e) =>
            match e
                Truncated(after) => test.assert_eq(after, 2)
                Overflow(after)  => test.fail("truncation reported as overflow after ${after}")

@test
fn test_an_oversized_varint_is_a_value() [io]
    // Ten bytes whose last carries more than the one bit left in 64.
    match leb128.decode(bytes.from_hex("ffffffffffffffffff02") ?? bytes.zeros(0))
        Ok(v)  => test.fail("an oversized varint decoded to ${v}")
        Err(e) =>
            match e
                Overflow(after)  => test.assert_eq(after, 10)
                Truncated(after) => test.fail("overflow reported as truncation after ${after}")

@test
fn test_an_eleventh_continuation_byte_is_an_overflow() [io]
    // The tenth byte may not continue: there is no eleventh group.
    match leb128.decode(bytes.from_hex("ffffffffffffffffff81") ?? bytes.zeros(0))
        Ok(v)  => test.fail("an eleven-byte varint decoded to ${v}")
        Err(e) =>
            match e
                Overflow(after)  => test.assert_eq(after, 10)
                Truncated(after) => test.fail("overflow reported as truncation after ${after}")

@test
fn test_encode_into_writes_where_it_is_told_and_allocates_nothing() [io]
    // One buffer, three varints appended in sequence, and the cursor
    // carrying the position from one to the next.
    var c = bytes.cursor_le(bytes.zeros(3 * leb128.max_len()))
    let a = leb128.encode_into(c, 0)
    let b = leb128.encode_into(c, 624485)
    let d = leb128.encode_into(c, 128)
    test.assert_eq(a, 1)
    test.assert_eq(b, 3)
    test.assert_eq(d, 2)
    test.assert_eq(c.pos(), 6)
    test.assert_eq_str(bytes.to_hex(bytes.slice(c.finish(), 0, 6)), "00e58e268001")

@test
fn test_decode_from_leaves_the_cursor_on_the_next_varint() [io]
    var c = bytes.cursor_le(bytes.from_hex("00e58e268001") ?? bytes.zeros(0))
    match leb128.decode_from(c)
        Err(e) => test.fail(e.message())
        Ok(v)  =>
            test.assert_eq(v, 0)
            test.assert_eq(c.pos(), 1)
    match leb128.decode_from(c)
        Err(e) => test.fail(e.message())
        Ok(v)  =>
            test.assert_eq(v, 624485)
            test.assert_eq(c.pos(), 4)
    match leb128.decode_from(c)
        Err(e) => test.fail(e.message())
        Ok(v)  =>
            test.assert_eq(v, 128)
            test.assert_eq(c.remaining(), 0)

@test
fn test_encoded_len_agrees_with_encode() [io]
    // The two answers must never disagree: `encode` sizes its buffer
    // from `encoded_len`, so a mismatch would truncate silently.
    for shift in 0..64
        let value = 1 << shift
        test.case("1 << ${shift}")
        test.assert_eq(leb128.encoded_len(value), bytes.len(leb128.encode(value)))

@test
fn test_decode_at_reports_the_length_it_read() [io]
    // Walking a buffer of three varints by offset rather than by
    // cursor: each answer carries the length that finds the next one.
    let buf = bytes.from_hex("00e58e268001") ?? bytes.zeros(0)
    var off = 0
    var values: [Int] = []
    for _step in 0..3
        match leb128.decode_at(buf, off)
            Err(e) => test.fail(e.message())
            Ok(d)  =>
                let value = d.value
                values = list.push(values, value)
                off = off + d.len
    test.assert_eq(off, bytes.len(buf))
    test.assert_eq(values[0], 0)
    test.assert_eq(values[1], 624485)
    test.assert_eq(values[2], 128)

@test
fn test_decode_at_agrees_with_encoded_len() [io]
    // The length `decode_at` reports and the length `encoded_len`
    // predicts must be the same number, or a reader and a writer
    // sharing a buffer would disagree about where a field ends.
    for shift in 0..64
        let value = 1 << shift
        test.case("1 << ${shift}")
        match leb128.decode_at(leb128.encode(value), 0)
            Err(e) => test.fail(e.message())
            Ok(d)  =>
                test.assert_eq(d.value, value)
                test.assert_eq(d.len, leb128.encoded_len(value))

@test
fn test_decode_at_outside_the_buffer_is_a_value() [io]
    // An offset that came out of the data being decoded is input, so it
    // is reported rather than being a reason to crash.
    let buf = bytes.from_hex("8001") ?? bytes.zeros(0)
    match leb128.decode_at(buf, 99)
        Ok(d)  => test.fail("an offset past the end decoded to ${d.value}")
        Err(e) =>
            match e
                Truncated(after) => test.assert_eq(after, 0)
                Overflow(after)  => test.fail("reported as overflow after ${after}")
    match leb128.decode_at(buf, 0 - 1)
        Ok(d)  => test.fail("a negative offset decoded to ${d.value}")
        Err(e) =>
            match e
                Truncated(after) => test.assert_eq(after, 0)
                Overflow(after)  => test.fail("reported as overflow after ${after}")
